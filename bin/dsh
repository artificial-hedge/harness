#!/bin/zsh
set -euo pipefail
ROOT="$(cd "$(dirname "$0")/.." && pwd)"
if [[ -f "$ROOT/.env" ]]; then
  set -a
  # shellcheck disable=SC1091
  source "$ROOT/.env"
  set +a
fi
export DSH_HOME="${DSH_HOME:-$ROOT/dsh-home}"
export PATH="$ROOT/bin:$PATH"
exec /usr/bin/env node "$ROOT/vendor/@deepseek-ai/dsh/lib/bin.js" "$@"
