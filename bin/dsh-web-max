#!/bin/zsh
set -euo pipefail

# Keep notebook kernels deterministic across host restarts. The envsel plugin
# can still override this per session through /env or its header selector.
export DSH_ENV_PYTHON="${DSH_ENV_PYTHON:-/Library/Developer/CommandLineTools/usr/bin/python3}"

# Public hostname is served by a reverse proxy / tunnel in front of loopback.
# DSH itself refuses --host 0.0.0.0; the trust fence must still allow the
# company hostname or the browser cookie exchange fails.
exec dsh web --no-open \
  --trusted-host harness.artificialhedge.co \
  --trusted-host harness.artificialhedge.co:443 \
  "$@"
