#!/bin/zsh
set -euo pipefail
ROOT="$(cd "$(dirname "$0")/.." && pwd)"
export DSH_ENV_PYTHON="${DSH_ENV_PYTHON:-/Library/Developer/CommandLineTools/usr/bin/python3}"
exec "$ROOT/bin/dsh" web --no-open \
  --trusted-host harness.artificialhedge.co \
  --trusted-host harness.artificialhedge.co:443 \
  "$@"
